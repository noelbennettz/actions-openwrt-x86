root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{yml,yaml,json}]
indent_size = 2

[*.sh]
# shell scripts are edited with 2-space continuation indents
indent_size = 2

[*.md]
# two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
